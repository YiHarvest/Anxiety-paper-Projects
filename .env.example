# TabPFN: required for licensed local model weights.
TABPFN_TOKEN=replace_with_prior_labs_api_key

# TaskWeaver: OpenAI-compatible LLM configuration.
LLM_API_TYPE=openai
LLM_API_KEY=replace_with_llm_api_key
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=replace_with_model_name

# PySR/Julia: preconfigured by HemoZero.
PYTHON_JULIAPKG_EXE=/home/yqy/.local/bin/julia
JULIA_NUM_THREADS=2

# Neo4j: required only by configs/workflows/hemozero_kg.yaml.
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_with_neo4j_password
NEO4J_DATABASE=neo4j
